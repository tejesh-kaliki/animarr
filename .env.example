# Copy to .env. Do not commit .env.
# DATA_DIR must be the same host directory the sonarr stack mounts at /data,
# so hardlinks from downloads into the library stay on one filesystem.
# Example: DATA_DIR=/Users/tejesh/projects/homelab/sonarr/data
DATA_DIR=./data

# Master switch for Nyaa searches, qBittorrent adds, library imports, NFO
# writes, and Jellyfin refresh. Off by default so a first start can sync
# AniList and run migrate-sonarr before anything is downloaded. Record the
# files you already have, then set this to true or turn it on in Settings.
# A saved Settings value overrides this.
AUTOMATION_ENABLED=false

ANILIST_USERNAME=

# Optional. Sent as Authorization: Bearer. A value saved in the UI overrides this
# and is stored encrypted. This variable itself is not copied into the database.
ANILIST_TOKEN=

# Key for secrets saved in the UI (AniList token, qBittorrent password, Jellyfin
# and Sonarr API keys). 32 raw bytes as base64 or hex, or a passphrase.
# When unset, the first start writes <DATA_PATH>/secret.key next to animarr.db.
# A copy of that directory then contains both the ciphertext and the key.
# Set this so a backup of /config does not unlock those secrets.
# ANIMARR_SECRET_KEY=

# qBittorrent shares the vpn namespace, so the WebUI is localhost.
# Leave both empty when the WebUI allows localhost without a password.
QB_USERNAME=
QB_PASSWORD=

# Jellyfin is on the media and homelab_proxy networks, not inside vpn.
# From the vpn namespace, Docker DNS on homelab_proxy resolves this name.
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=

# Used only by `animarr migrate-sonarr`. Sonarr is in the same namespace.
SONARR_URL=http://127.0.0.1:8989
SONARR_API_KEY=

# Write Jellyfin/Kodi NFO files next to new imports and --relayout moves.
# Set to false to leave metadata to Jellyfin's own providers.
# NFO_ENABLED=true
